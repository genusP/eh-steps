{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build",
            "type": "shell",
            "command": "esphome compile ${workspaceFolder}/steps.yaml",
            "presentation": {
                "reveal": "always"
            },
            "problemMatcher": "$gcc",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Build Debug",
            "type": "shell",
            "command": "esphome -s build_type debug compile ${workspaceFolder}/steps.yaml",
            "presentation": {
                "reveal": "always"
            },
            "problemMatcher": "$gcc",
            "group": {
                "kind": "build"
            }
        },
        {
            "label": "Run Wokwi Debug",
            "command": "${command:wokwi-vscode.startAndWait}",
            "problemMatcher": "$gcc",
            "dependsOn": [ "Build Debug" ]
        }
    ]
}
